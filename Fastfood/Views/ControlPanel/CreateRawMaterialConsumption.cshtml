@model Fastfood.ViewModel.RawMaterialConsumptionVM

@{
    ViewData["Title"] = "Add Raw Material Consumption";
    var permission = TempData["Permission"] as string;
}

@if (!string.IsNullOrEmpty(permission))
{
    <div class="d-flex justify-content-center align-items-center vh-100">
        <div class="text-center p-4 border border-danger rounded shadow-sm"
             style="max-width:400px;background:#fff0f1;color:#842029;">
            <h4 class="mb-3 font-weight-bold">Access Denied</h4>
            <p>You do not have the necessary permissions to access this page.</p>

            <a asp-action="Index"
               asp-controller="ControlPanel"
               class="btn btn-danger px-4">
                Return to Home
            </a>
        </div>
    </div>
}
else
{
    <style>
        body {
            background: #F4F6FA;
            font-family: 'Segoe UI', sans-serif;
        }

        .form-container {
            max-width: 850px;
            margin: 40px auto;
            background: #fff;
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 0 15px rgba(0,0,0,.08);
            border-left: 4px solid #3EADFA;
        }

        h2 {
            color: #3EADFA;
        }

        .btn-custom {
            background-color: #3EADFA;
            color: #fff;
        }

            .btn-custom:hover {
                background-color: #1F75C1;
            }
    </style>

    <div class="container">
        <div class="form-container">
            <form method="post" asp-action="CreateRawMaterialConsumption" asp-controller="ControlPanel">
                <h2 class="text-center mb-4">Add Raw Material Consumption</h2>

                <!-- SINGLE BASE ITEM SELECT -->
                <div class="form-group">
                    <label class="font-weight-bold">Base Item (Menu Item) for All</label>
                    <select name="BaseItemId" class="form-control" required>
                        <option value="">--- Select Base Item ---</option>
                        @foreach (var b in Model.BaseItems)
                        {
                            <option value="@b.ItemId">@b.ItemName</option>
                        }
                    </select>
                </div>

                <!-- RAW MATERIAL TABLE -->
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Raw Material</th>
                            <th>Quantity</th> 
                            <th>Remarks</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="rows">
                        <tr>
                            <td>
                                <select name="Consumptions[0].RMInv_ItemId" class="form-control" required>
                                    <option value="">-- Select --</option>
                                    @foreach (var r in Model.Consumeables)
                                    {
                                        <option value="@r.CMID">@r.CMName</option>
                                    }
                                </select>
                            </td>
                            <td><input name="Consumptions[0].RMQTY" class="form-control" required /></td>
                            
                            <td><input name="Consumptions[0].Remarks" class="form-control" /></td>
                            <td><button type="button" class="btn btn-danger remove">X</button></td>
                        </tr>
                    </tbody>
                </table>

                <button type="button" class="btn btn-info mb-3" id="addRow">Add Item</button>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="RawMaterialConsumption" asp-controller="ControlPanel" class="btn btn-secondary">Back</a>
                    <button type="submit" class="btn btn-custom">Save All</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        let index = 1;
        const rows = document.getElementById("rows");

        document.getElementById("addRow").addEventListener("click", function () {
            const row = `
            <tr>
                <td>
                    <select name="Consumptions[${index}].RMInv_ItemId" class="form-control" required>
                        <option value="">-- Select --</option>
                        @foreach (var r in Model.Consumeables)
                        {
                                    <option value="@r.CMID">@r.CMName</option>
                        }
                    </select>
                </td>
                <td><input name="Consumptions[${index}].RMQTY" class="form-control" required /></td>
                <td><input name="Consumptions[${index}].Remarks" class="form-control" /></td>
                <td><input name="Consumptions[${index}].Unit" class="form-control" /></td>
                <td><button type="button" class="btn btn-danger remove">X</button></td>
            </tr>`;
            rows.insertAdjacentHTML("beforeend", row);
            index++;
        });

        document.addEventListener("click", function (e) {
            if (e.target.classList.contains("remove")) {
                e.target.closest("tr").remove();
            }
        });
    </script>
}

@{
    var permission = TempData["Permission"] as string;
}

@if (!string.IsNullOrEmpty(permission))
{
    <div style="display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0;">
        <div style="width: 400px; text-align: center; padding: 30px; border: 2px dashed #dc3545; border-radius: 10px; background-color: #fff0f1; color: #842029; box-shadow: 0 0 12px rgba(220, 53, 69, 0.2); font-family: 'Segoe UI', sans-serif;">
            <div style="font-size: 24px; font-weight: bold; margin-bottom: 10px;">Access Denied</div>
            <div style="font-size: 16px; margin-bottom: 20px;">
                You do not have the necessary permissions to access this page.
            </div>
            <a asp-action="Index" asp-controller="ControlPanel"
               style="display: inline-block; padding: 10px 25px; background-color: #dc3545; color: #fff; text-decoration: none; border-radius: 6px; font-weight: bold; transition: background-color 0.3s;">
                Return to Home
            </a>
        </div>
    </div>
}
else
{
    @using Fastfood.ViewModel
@model RawMaterialConsumptionVM

    <!DOCTYPE html>
    <html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
        <title>Add Raw Material Consumption</title>
        <style>
            body {
                background: #F4F6FA;
                font-family: 'Segoe UI', sans-serif;
            }

            .form-container {
                max-width: 800px;
                margin: auto;
                background-color: #ffffff;
                padding: 40px;
                border-radius: 8px;
                box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
                border-left: 4px solid #3EADFA;
            }

            h2 {
                color: #3EADFA;
            }

            .btn-custom {
                background-color: #3EADFA;
                color: #fff;
                border: none;
            }

                .btn-custom:hover {
                    background-color: #1F75C1;
                }

            .btn-secondary a {
                color: white;
                text-decoration: none;
            }
        </style>
    </head>

    <body>
        <div class="container">
            <div class="form-container">
                <form method="post" asp-action="EditRawMaterialConsumption" asp-controller="ControlPanel">
                    <h2 class="text-center mb-4">Add Raw Material Consumption</h2>
                    <input type="hidden" asp-for="Consumption.S_No" />
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Raw Material</label>
                            <select asp-for="Consumption.RMInv_ItemId" class="form-control"
                                    asp-items="@(new SelectList(Model.Consumeables, "CMID", "CMName"))">
                                <option value="">--- Select Raw Material ---</option>
                            </select>
                        </div>
                        <div class="form-group col-md-6">
                            <label>Quantity</label>
                            <input asp-for="Consumption.RMQTY" class="form-control" placeholder="Enter Quantity" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Base Item (Menu Item)</label>
                            <select asp-for="Consumption.BInv_ItemId" class="form-control"
                                    asp-items="@(new SelectList(Model.BaseItems, "ItemId", "ItemName", Model.Consumption.BInv_ItemId))">
                                <option value="">--- Select Base Item ---</option>
                            </select>

                        </div>
                        <div class="form-group col-md-6">
                            <label>Remarks</label>
                            <input asp-for="Consumption.Remarks" class="form-control" placeholder="Enter Remarks" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="RawMaterialConsumption" asp-controller="ControlPanel" class="btn btn-secondary">Back</a>
                        <button type="submit" class="btn btn-custom">Update</button>
                    </div>
                </form>
            </div>
        </div>
    </body>
    </html>
}

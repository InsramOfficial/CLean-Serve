@{
    var permission = TempData["Permission"] as string;
}

@if (!string.IsNullOrEmpty(permission))
{
    <div style="display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0;">
        <div style="width: 400px; text-align: center; padding: 30px; border: 2px dashed #dc3545; border-radius: 10px; background-color: #fff0f1; color: #842029; box-shadow: 0 0 12px rgba(220, 53, 69, 0.2); font-family: 'Segoe UI', sans-serif;">
            <div style="font-size: 24px; font-weight: bold; margin-bottom: 10px;">Access Denied</div>
            <div style="font-size: 16px; margin-bottom: 20px;">
                You do not have the necessary permissions to access this page.
            </div>
            <a asp-action="Index" asp-controller="ControlPanel"
               style="display: inline-block; padding: 10px 25px; background-color: #dc3545; color: #fff; text-decoration: none; border-radius: 6px; font-weight: bold; transition: background-color 0.3s;">
                Return to Home
            </a>
        </div>
    </div>
}
else
{
    @using Fastfood.ViewModel
@model RawMaterialConsumptionVM

    <div class="container mt-5">
        <div class="form-container">

            <form method="post" asp-action="EditRawMaterialConsumption">
                <h2 class="text-center mb-4">Edit Raw Material Consumption</h2>
                  <!-- Base Item Name -->
            <h4 class="mb-3">
                Editing ingredients for: 
                <strong>@ViewBag.BaseItemName</strong>
            </h4>

                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Raw Material</th>
                            <th>Quantity</th>
                            <th>Unit</th>
                            <th>Remarks</th>
                            <th>Remove</th>
                        </tr>
                    </thead>
                    <tbody>
                    @for (int i = 0; i < Model.Consumptions.Count; i++)
                        {
                            <tr>
                                <td>
                                    <input type="hidden" asp-for="Consumptions[i].S_No" />
                                    <input type="hidden" asp-for="Consumptions[i].BInv_ItemId" />

                                    <select asp-for="Consumptions[i].RMInv_ItemId"
                                            class="form-control"
                                            asp-items="@(new SelectList(Model.Consumeables, "CMID", "CMName", Model.Consumptions[i].RMInv_ItemId))">
                                    </select>
                                </td>

                                <td>
                                    <input asp-for="Consumptions[i].RMQTY" class="form-control" />
                                </td>
                                <td>
                                    <input readonly asp-for="Consumptions[i].Unit.UnitName" class="form-control" />
                                </td>

                                <td>
                                    <input asp-for="Consumptions[i].Remarks" class="form-control" />
                                </td>

                                <td class="text-center">
                                    <input asp-for="Consumptions[i].IsDeleted" type="checkbox" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="d-flex justify-content-between">
                    <a asp-action="RawMaterialConsumption" class="btn btn-secondary">Back</a>
                    <button type="submit" class="btn btn-primary">Update All</button>
                </div>
            </form>

        </div>
    </div>

    <style>
        .form-container {
            max-width: 900px;
            margin: auto;
            background-color: #ffffff;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
            border-left: 4px solid #3EADFA;
        }

        h2 {
            color: #3EADFA;
        }

        .btn-primary {
            background-color: #3EADFA;
            border: none;
        }

            .btn-primary:hover {
                background-color: #1F75C1;
            }

        .btn-secondary {
            background-color: #6c757d;
            color: #fff;
        }
    </style>
}

@model IEnumerable<Fastfood.Models.Inv_Purchase>

@{
    var permission = TempData["Permission"] as string;
    var ToastMessage = TempData["ToastMessage"] as string;
    var ToastType = TempData["ToastType"] as string;
}

@if (!string.IsNullOrEmpty(permission))
{
    <div style="display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0;">
        <div style="width: 400px; text-align: center; padding: 30px; border: 2px dashed #dc3545; border-radius: 10px; background-color: #fff0f1; color: #842029; box-shadow: 0 0 12px rgba(220, 53, 69, 0.2); font-family: 'Segoe UI', sans-serif;">
            <div style="font-size: 24px; font-weight: bold; margin-bottom: 10px;">Access Denied</div>
            <div style="font-size: 16px; margin-bottom: 20px;">You do not have the necessary permissions to access this page.</div>
            <a asp-action="Index" asp-controller="ControlPanel"
               style="display: inline-block; padding: 10px 25px; background-color: #dc3545; color: #fff; text-decoration: none; border-radius: 6px; font-weight: bold; transition: background-color 0.3s;">
                Return to Home
            </a>
        </div>
    </div>
}
else
{
    <!doctype html>
    <html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <title>Purchases</title>
        <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdn.datatables.net/1.10.22/css/jquery.dataTables.min.css" rel="stylesheet">
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
        <style>
            .table-container {
                max-height: 340px;
                overflow-y: auto;
            }

            #dataTables-example thead th {
                position: sticky;
                top: 0;
                background-color: #fff;
                z-index: 1;
            }

            .page-title {
                margin: 0;
                font-size: 1.5rem;
                line-height: 1.5555556;
            }

            .box {
                position: relative;
                border-radius: 3px;
                background: #ffffff;
                border-top: 3px solid #d2d6de;
                margin-bottom: 20px;
                width: 100%;
                box-shadow: 0 1px 1px rgba(0,0,0,0.1);
            }

            .box-primary {
                border-top-color: #22a1f9;
            }

            .btn-rounded {
                border-radius: 10em;
                padding: 6px 8px;
                font-size: small;
                text-transform: none;
                background: #eaeaea;
                border: none;
            }

                .btn-rounded:hover {
                    border: none;
                }

            .fixed-width-search-container {
                width: 250px;
            }
        </style>
    </head>
    <body>
        @if (!string.IsNullOrEmpty(ToastMessage))
        {
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    showToast("@ToastMessage", "@ToastType");
                });
            </script>
        }

        <div class="container mt-4">
            <div class="page-title d-flex align-items-center justify-content-between">
                <h3>
                    <i class="bi bi-bag-check-fill"></i> Purchases
                </h3>
                <a asp-action="CreatePurchase" asp-controller="ControlPanel" class="btn btn-sm btn-outline-primary">
                    <i class="fas fa-plus-circle"></i> Add New Purchase
                </a>
            </div>

            <div class="box box-primary">
                <div class="box-body">
                    <div class="input-group mb-3 fixed-width-search-container">
                        <input type="text" class="form-control" id="searchInput" placeholder="Search for Purchase..." oninput="searchPurchase()">
                    </div>

                    <div class="table-container">
                        <table class="table table-hover" id="dataTables-example">
                            <thead>
                                <tr>
                                    <th>Supplier</th>
                                    <th>Purchase Date</th>
                                    <th>Total Items</th>
                                    <th>Total Amount</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Supplier?.Name</td>
                                        <td>@item.PurchaseDate?.ToString("yyyy-MM-dd")</td>
                                        <td>@item.PurchasedItems?.Count()</td>
                                        <td>@item.PurchasedItems?.Sum(x => x.Qty * x.UnitPrice)</td>
                                        <td>
                                            <a asp-action="PrintPurchaseBill" asp-controller="Reports" asp-route-id="@item.PurchaseId" target="_blank" class="btn btn-outline-dark btn-rounded">
                                                <i class="fas fa-print"></i> Print
                                            </a>

                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
        <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
        <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.11.7/js/jquery.dataTables.js"></script>

        <script>
            $(document).ready(function () {
                $('#dataTables-example').DataTable();
            });

            function searchPurchase() {
                var input = $('#searchInput').val().toLowerCase();
                $('#dataTables-example tbody tr').each(function () {
                    var rowData = $(this).find('td:eq(0)').text().toLowerCase();
                    $(this).toggle(input === '' || rowData.indexOf(input) !== -1);
                });
            }
        </script>
    </body>
    </html>
}

@model List<Client>
@{
    var permission = TempData["Permission"] as string;
    var ToastMessage = TempData["ToastMessage"] as string;
    var ToastType = TempData["ToastType"] as string;
}

@if (!string.IsNullOrEmpty(permission))
{
    @* Access Denied Design *@
    <div style="display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0;">
        <div style="width: 400px; text-align: center; padding: 30px; border: 2px dashed #dc3545; border-radius: 10px; background-color: #fff0f1; color: #842029; box-shadow: 0 0 12px rgba(220, 53, 69, 0.2); font-family: 'Segoe UI', sans-serif;">
            <div style="font-size: 24px; font-weight: bold; margin-bottom: 10px;">Access Denied</div>
            <div style="font-size: 16px; margin-bottom: 20px;">
                You do not have the necessary permissions to access this page.
            </div>
            <a asp-action="Index" asp-controller="ControlPanel"
               style="display: inline-block; padding: 10px 25px; background-color: #dc3545; color: #fff; text-decoration: none; border-radius: 6px; font-weight: bold; transition: background-color 0.3s;">
                Return to Home
            </a>
        </div>
    </div>
}
else
{
    <!doctype html>
    <html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <title>Customer Sales History</title>
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
        <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdn.datatables.net/1.10.22/css/jquery.dataTables.min.css" rel="stylesheet">
        <style>
            .table-container {
                max-height: 450px;
                overflow-y: auto;
            }

            #dataTables-example thead th {
                position: sticky;
                top: 0;
                background-color: #fff;
                z-index: 1;
            }

            #body > .content {
                position: relative;
                padding: .5rem;
            }

            .page-title {
                margin: 0;
                font-size: 1.5rem;
                line-height: 1.5555556;
            }

            .box {
                position: relative;
                border-radius: 3px;
                background: #ffffff;
                border-top: 3px solid #d2d6de;
                margin-bottom: 20px;
                width: 100%;
                box-shadow: 0 1px 1px rgba(0, 0, 0, 0.1);
            }

            .box-primary {
                border-top-color: #22a1f9;
            }

            .btn-rounded {
                border-radius: 10em;
                padding: 6px 12px;
                font-size: small;
                background: #eaeaea;
                border: none;
            }

            .fixed-width-search-container {
                width: 300px;
            }
        </style>
    </head>
    <body>

        @if (!string.IsNullOrEmpty(ToastMessage))
        {
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    showToast("@ToastMessage", "@ToastType");
                });
            </script>
        }

        <div class="wrapper">
            <div id="body" class="active">
                <div class="content">
                    <div class="container">
                        <div class="page-title">
                            <h3><i class="fas fa-history"></i> Customer Sales History</h3>
                        </div>

                        <div class="box box-primary">
                            <div class="box-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="input-group fixed-width-search-container">
                                        <input type="text" class="form-control" id="searchInput" placeholder="Search Customer or Phone..." oninput="searchCustomers()">
                                    </div>
                                </div>

                                <div class="table-container">
                                    <table class="table table-hover" id="dataTables-example">
                                        <thead>
                                            <tr>
                                                <th>No</th>
                                                <th>Customer Name</th>
                                                <th>Phone Number</th>
                                                <th>Address</th>
                                                <th class="text-center">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                int i = 1;
                                            }
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>@i</td>
                                                    <td class="font-weight-bold">@item.Name</td>
                                                    <td>@item.PhoneNo</td>
                                                    <td>@item.Address</td>
                                                    <td class="text-center">
                                                        <a asp-controller="Reports"
                                                           asp-action="PrintCustomerHistory"
                                                           asp-route-customerId="@item.Clientid"
                                                           class="btn btn-outline-danger btn-rounded">
                                                            <i class="fas fa-file-pdf"></i> Print History
                                                        </a>
                                                    </td>
                                                </tr>
                                                i++;
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
        <script src="https://cdn.datatables.net/1.10.22/js/jquery.dataTables.min.js"></script>
        <script>
            $(document).ready(function () {
                $('#dataTables-example').DataTable({
                    "dom": 't', // Only show table, we use custom search
                    "paging": false
                });
            });

            function searchCustomers() {
                var input = $('#searchInput').val().toLowerCase();
                $('#dataTables-example tbody tr').each(function () {
                    var rowText = $(this).text().toLowerCase();
                    $(this).toggle(rowText.indexOf(input) !== -1);
                });
            }
        </script>
    </body>
    </html>
}
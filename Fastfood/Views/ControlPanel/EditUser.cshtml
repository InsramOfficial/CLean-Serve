@{
    var permission = TempData["Permission"] as string;
}

@if (!string.IsNullOrEmpty(permission))
{
    <div style="display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0;">
        <div style="width: 400px; text-align: center; padding: 30px; border: 2px dashed #dc3545; border-radius: 10px; background-color: #fff0f1; color: #842029; box-shadow: 0 0 12px rgba(220, 53, 69, 0.2); font-family: 'Segoe UI', sans-serif;">
            <div style="font-size: 24px; font-weight: bold; margin-bottom: 10px;">Access Denied</div>
            <div style="font-size: 16px; margin-bottom: 20px;">
                You do not have the necessary permissions to access this page.
            </div>
            <a asp-action="Index" asp-controller="ControlPanel"
               style="display: inline-block; padding: 10px 25px; background-color: #dc3545; color: #fff; text-decoration: none; border-radius: 6px; font-weight: bold; transition: background-color 0.3s;">
                Return to Home
            </a>
        </div>
    </div>
}
else
{
    @using Fastfood.ViewModel;
    @model Register;

    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>Update User</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
        <style>
            body {
                background-color: #F4F6FA;
                display: flex;
                justify-content: center;
                align-items: center;
                height: 100vh;
                margin: 0;
            }

            .card-custom {
                width: 100%;
                max-width: 600px;
                padding: 30px;
                background: #fff;
                border-radius: 10px;
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
                font-family: 'Segoe UI', sans-serif;
            }

            .form-control {
                border-radius: 6px;
            }

            .btn-custom {
                background-color: #3EADFA;
                color: white;
                border: none;
            }

                .btn-custom:hover {
                    background-color: #1F75C1;
                }

            .header-img {
                display: block;
                margin: 0 auto 20px;
                max-height: 100px;
            }

            .form-title {
                font-size: 24px;
                font-weight: bold;
                margin-bottom: 20px;
                text-align: center;
            }

            .btn-back a {
                color: white;
                text-decoration: none;
            }

            .btn-back:hover a {
                color: white;
            }
        </style>
    </head>
    <body>
        <div class="card-custom">
            <img src="~/images/user.png" alt="User Icon" class="header-img" />
            <div class="form-title">Update User</div>
            <form method="post" asp-action="EditUser" asp-controller="ControlPanel">
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label asp-for="ID">User ID</label>
                        <input asp-for="ID" class="form-control" placeholder="Enter User ID">
                        <input asp-for="UserCode" type="hidden" />
                    </div>
                    <div class="form-group col-md-6">
                        <label asp-for="Password">Password</label>
                        <input asp-for="Password" class="form-control" placeholder="Enter Password">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label asp-for="Name">User Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Enter Name">
                    </div>
                    <div class="form-group col-md-6">
                        <label asp-for="Access">Access</label>
                        <select asp-for="Access" class="form-control">
                            <option value="">---Select---</option>
                            <option value="Admin">Admin</option>
                            <option value="User">User</option>
                            <option value="Employee">Employee</option>
                        </select>
                    </div>
                </div>
                <div class="d-flex justify-content-between mt-4">
                    <button class="btn btn-secondary btn-back">
                        <a asp-action="UserList" asp-controller="ControlPanel">Back</a>
                    </button>
                    <button type="submit" class="btn btn-custom">Update</button>
                </div>
            </form>
        </div>
    </body>
    </html>
}

@{
    var permission = TempData["Permission"] as string;
}

@if (!string.IsNullOrEmpty(permission))
{
    <div style="display: flex; align-items: center; justify-content: center; height: 100vh;">
        <div style="width: 400px; text-align: center; padding: 30px; border: 2px dashed #dc3545; border-radius: 10px; background-color: #fff0f1; color: #842029; box-shadow: 0 0 12px rgba(220, 53, 69, 0.2); font-family: 'Segoe UI', sans-serif;">
            <div style="font-size: 24px; font-weight: bold; margin-bottom: 10px;">Access Denied</div>
            <div style="font-size: 16px; margin-bottom: 20px;">
                You do not have the necessary permissions to access this page.
            </div>
            <a asp-action="Index" asp-controller="ControlPanel"
               style="display: inline-block; padding: 10px 25px; background-color: #dc3545; color: #fff; text-decoration: none; border-radius: 6px; font-weight: bold; transition: background-color 0.3s;">
                Return to Home
            </a>
        </div>
    </div>
}
else
{
    @using Fastfood.ViewModel;
    @model ItemsVM;

    <!DOCTYPE html>
    <html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
        <title>Update Item</title>
        <style>
            body {
                background: #f8f9fa;
                font-family: 'Segoe UI', sans-serif; 
            }

            .card-form {
                max-width: 750px;
                margin: auto;
                padding: 40px;
                background-color: #fff;
                border-radius: 10px;
                box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
                border-left: 5px solid #28a745;
            }

            .form-title {
                color: #28a745;
                margin-bottom: 20px;
                text-align: center;
            }

            .image-preview {
                display: flex;
                justify-content: center;
                margin-bottom: 20px;
            }

                .image-preview img {
                    width: 120px;
                    height: 120px;
                    border-radius: 50%;
                    object-fit: cover;
                    border: 3px solid #28a745;
                }

            .btn-custom {
                background-color: #28a745;
                color: white;
                border: none;
            }

                .btn-custom:hover {
                    background-color: #1e7e34;
                }

            .btn-secondary a {
                color: white;
                text-decoration: none;
            }
        </style>
    </head>

    <body>
        <div class="container">
            <div class="card-form">
                <form method="post" asp-action="EditItem" asp-controller="ControlPanel" enctype="multipart/form-data">
                    <input asp-for="ItemId" type="hidden" />

                    <div class="image-preview">
                        @if (!string.IsNullOrEmpty(Model.Picture))
                        {
                            <img src="~/images/@Model.Picture" alt="Current Image" />
                        }
                        else
                        {
                            <img src="https://via.placeholder.com/120" alt="No Image" />
                        }
                    </div>

                    <h3 class="form-title">Update Item</h3>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label asp-for="ItemName">Item Name</label>
                            <input asp-for="ItemName" class="form-control" placeholder="Enter Item Name">
                        </div>
                        <div class="form-group col-md-6">
                            <label asp-for="RecentUnitPrice">Unit Price</label>
                            <input asp-for="RecentUnitPrice" class="form-control" placeholder="Enter Unit Price">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label asp-for="Discount">Discount</label>
                            <input asp-for="Discount" class="form-control" placeholder="Enter Discount">
                        </div>
                        <div class="form-group col-md-6">
                            <label asp-for="CategoryId">Category</label>
                            <select asp-for="CategoryId" class="form-control">
                                <option value="">--- Select ---</option>
                                @foreach (var item in Model.category)
                                {
                                    <option value="@item.CategoryId">@item.CategoryName</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label asp-for="ItemImage">Change Image</label>
                            <input asp-for="ItemImage" type="file" class="form-control-file" />
                        </div>
                        <div class="form-group col-md-6">
                            <label asp-for="ItemType">Item Type</label>
                            <select asp-for="ItemType" class="form-control">
                                <option value="">-- Select Item Type --</option>
                                <option value="Beverage">Beverage (e.g. Drinks)</option>
                                <option value="Inhouse Built">Inhouse Built (e.g. Recipe)</option>
                            </select>
                            <span asp-validation-for="ItemType" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Remarks">Remarks</label>
                        <input asp-for="Remarks" class="form-control" placeholder="Enter Remarks">
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="ItemsDetail" asp-controller="ControlPanel" class="btn btn-secondary">Back</a>
                        <button type="submit" class="btn btn-custom">Update</button>
                    </div>
                </form>
            </div>
        </div>
    </body>
    </html>
}

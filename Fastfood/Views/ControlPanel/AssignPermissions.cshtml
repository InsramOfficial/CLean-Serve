@{
	var permission = TempData["Permission"] as string;
	var ToastMessage = TempData["ToastMessage"] as string;
	var ToastType = TempData["ToastType"] as string;
}

@if (!string.IsNullOrEmpty(permission))
{
	<div style="display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0;">
		<div style="width: 350px; text-align: center; padding: 30px; border: 2px dashed #dc3545; border-radius: 10px; background-color: #fff0f1; color: #842029; box-shadow: 0 0 12px rgba(220, 53, 69, 0.2); font-family: 'Segoe UI', sans-serif;">
			<div style="font-size: 20px; font-weight: bold; margin-bottom: 10px;">@TempData["Permission"]</div>
			<a asp-action="UsersDetail" asp-controller="ControlPanel" class="btn btn-danger mt-2">OK</a>
		</div>
	</div>
}
else
{
	@using Fastfood.ViewModel;
	@model AssignPermissionVM;

	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>User Permissions</title>

		<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />
		<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
		<link href="https://cdn.datatables.net/1.10.22/css/jquery.dataTables.min.css" rel="stylesheet" />

		<style>
			body {
				background-color: #f4f6fa;
				font-family: 'Segoe UI', sans-serif;
				color: black;
			}

			.card {
				border-radius: 8px;
				box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05); 
			}

			.card-header {
				background-color: transparent;
				border-bottom: 1px solid #dee2e6;
			}

			.table-container {
				max-height: 340px;
				overflow-y: auto;
			}

			#dataTables-example thead th {
				position: sticky;
				top: 0;
				z-index: 1;
			}

			input[type="checkbox"] {
				transform: scale(1.3);
				cursor: pointer;
			}

			.page-title h3 {
				margin: 20px 0;
				font-size: 1.6rem;
			}

			.fixed-width-search-container {
				width: 250px;
			}

			.form-control-plaintext {
				border: none;
				background-color: transparent;
				box-shadow: none;
				color: black;
			}

			table {
				border-radius: 10px;
				overflow: hidden;
				box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
			}

			.custom-thead {
				background-color: #000 !important;
				color: #fff;
			}

				.custom-thead th {
					border-color: #444;
				}
		</style>
	</head>

	<body>
		@if (!string.IsNullOrEmpty(ToastMessage))
		{
			<script>
				document.addEventListener("DOMContentLoaded", function () {
					showToast("@ToastMessage", "@ToastType");
				});
			</script>
		}

		<form asp-action="AssignPermissions" asp-controller="ControlPanel" method="post">
			<div class="container wrapper">
				<div class="card">
					<div class="card-header d-flex justify-content-between align-items-center">
						<div class="page-title">
							<h3>User Permissions</h3>
						</div>
						<div>
							<b>User:</b>
							<input asp-for="@Model.user.Name" readonly class="form-control-plaintext d-inline-block" style="width: auto;" />
						</div>
					</div>

					<div class="card-body">
						<div class="input-group mb-3 fixed-width-search-container">
							<input type="text" class="form-control" id="searchInput" placeholder="Search by Permission ID..." oninput="searchCategory()" />
						</div>

						<div class="table-container">
							<table class="table table-striped table-hover" id="dataTables-example">
								<thead class="custom-thead">
									<tr>
										<th>Permission Id</th>
										<th>User Code</th>
										<th>Method Id</th>
										<th>Method Name</th>
										<th>Active</th>
									</tr>
								</thead>
								<tbody>
									@for (int i = 0; i < Model.permissions.Count; i++)
									{
										<tr>
											<td>
												<input asp-for="@Model.permissions[i].PermissionId" readonly class="form-control-plaintext" />
											</td>
											<td>
												<input asp-for="@Model.permissions[i].UserCode" readonly class="form-control-plaintext" />
											</td>
											<td>
												<input asp-for="@Model.permissions[i].MethodId" readonly class="form-control-plaintext" />
											</td>
											<td>
												<input asp-for="@Model.permissions[i].MethodName" readonly class="form-control-plaintext" />
											</td>
											<td class="text-center">
												<input asp-for="@Model.permissions[i].View" type="checkbox" />
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>

						<div class="text-right mt-4">
							<button type="submit" class="btn btn-success">Update</button>
							<a asp-action="UsersDetail" asp-controller="ControlPanel" class="btn btn-secondary ml-2">Back</a>
						</div>
					</div>
				</div>
			</div>
		</form>

		<!-- Scripts -->
		<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
		<script src="https://cdn.datatables.net/1.11.7/js/jquery.dataTables.min.js"></script>

		<script>
			$(document).ready(function () {
				$('#dataTables-example').DataTable({
					paging: false,
					info: false
				});
			});

			function searchCategory() {
				var input = $('#searchInput').val().toLowerCase();
				$('#dataTables-example tbody tr').each(function () {
					var rowData = $(this).find('td:eq(0)').text().toLowerCase();
					$(this).toggle(rowData.indexOf(input) !== -1 || input === '');
				});
			}
		</script>
	</body>
	</html>
}

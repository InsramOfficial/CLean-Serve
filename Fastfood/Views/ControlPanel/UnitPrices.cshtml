@model IEnumerable<Fastfood.Models.UnitPrice>

@{
    var ToastMessage = TempData["ToastMessage"] as string;
    var ToastType = TempData["ToastType"] as string;
}

<!DOCTYPE html>
<html>
<head>
    <title>Unit Management</title> 
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/fontawesome.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/solid.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/brands.min.css" rel="stylesheet">
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.10.22/css/jquery.dataTables.min.css" rel="stylesheet">
    <style>
        .btn-rounded {
            border-radius: 10em;
            padding: 6px 12px;
            font-size: small;
        }

        #dataTables-example thead th {
            position: sticky;
            top: 0;
            background: #fff;
            z-index: 1;
        }
    </style>
</head>
<body>
    @if (!string.IsNullOrEmpty(ToastMessage))
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                alert("@ToastMessage");
            });
        </script>
    }

    <div class="container mt-4">
        <h3>
            Unit Management
            <a asp-action="CreateUnitPrice" class="btn btn-sm btn-outline-primary float-right">
                <i class="fas fa-plus-circle"></i> Add Unit
            </a>
        </h3>

        <div class="table-responsive mt-3">
            <table class="table table-hover" id="dataTables-example">
                <thead>
                    <tr>
                        <th>Unit Name</th>
                        <th>Unit Code</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var unit in Model)
                    {
                        <tr>
                            <td>@unit.UnitName</td>
                            <td>@unit.UnitCode</td>
                            <td>
                                <a asp-action="EditUnitPrice" asp-route-id="@unit.UnitId" class="btn btn-outline-info btn-rounded">
                                    <i class="fas fa-pen"></i>
                                </a>
                                <a href="javascript:void(0);" class="btn btn-outline-danger btn-rounded"
                                   onclick="confirmDelete('@unit.UnitId')">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1">
        <div class="modal-dialog" style="margin-top: 50px;">
            <div class="modal-content border-danger">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="fas fa-exclamation-triangle"></i> Confirm Deletion</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    Are you sure you want to delete this unit? This action cannot be undone.
                </div>
                <div class="modal-footer justify-content-center">
                    <a id="confirmDeleteBtn" class="btn btn-danger">Yes, Delete</a>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.7/js/jquery.dataTables.js"></script>
    <script>
        $(document).ready(function () { $('#dataTables-example').DataTable(); });

        function confirmDelete(id) {
            const deleteUrl = `/ControlPanel/DeleteUnitPrice/${id}`;
            $('#confirmDeleteBtn').attr('href', deleteUrl);
            $('#deleteConfirmModal').modal('show');
        }
    </script>
</body>
</html>

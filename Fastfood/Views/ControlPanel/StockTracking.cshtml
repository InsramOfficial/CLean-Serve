@{

	var permission = TempData["Permission"] as string;
	var ToastMessage = TempData["ToastMessage"] as string;
	var ToastType = TempData["ToastType"] as string;
} 
 
<!doctype html>
<html lang="en">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<title>Current Stocks</title>
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/fontawesome.min.css" rel="stylesheet">
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/solid.min.css" rel="stylesheet">
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/brands.min.css" rel="stylesheet">
	<link href="https://cdn.datatables.net/1.10.22/css/jquery.dataTables.min.css" rel="stylesheet">
	 
	<style>
		/* Add custom styles here */
		.table-container {
			max-height: 340px;
			/* Adjust the max-height based on your requirement */
			overflow-y: auto;
		}

		#dataTables-example thead th {
			position: sticky;
			top: 0;
			background-color: #fff;
			/* Set the background color you desire */
			z-index: 1;
		}
		 

		/*------------------------------------------------------------------
											[4. Content / #content]
											*/
		#body > .content {
			position: relative;
			padding: .5rem;
		}

		#body .content .page-title h3 {
			margin: 1rem 0;
		}


		.page-title {
			margin: 0;
			font-size: 1.5rem;
			line-height: 1.5555556;
		}

		.box {
			position: relative;
			border-radius: 3px;
			background: #ffffff;
			border-top: 3px solid #d2d6de;
			margin-bottom: 20px;
			width: 100%;
			box-shadow: 0 1px 1px rgba(0, 0, 0, 0.1);
		}


		.box-primary {
			border-top-color: #22a1f9;
		}

		/*------------------------------------------------------------------
											[7. Dashboard Cards / .card]
											*/


		/*------------------------------------------------------------------
											[8. Miscellaneous ]
											*/


		.nav-pills {
			padding: 15px;
			background-color: #E0E0E0;
			-webkit-box-shadow: 0 3px 10px 0 rgba(0, 0, 0, 0.05);
			box-shadow: 0 3px 10px 0 rgba(0, 0, 0, 0.05);
		}

		.btn-rounded {
			border-radius: 10em;
			padding: 6px 8px;
			font-size: small;
			text-transform: none;
			text-shadow: none !important;
			background: #eaeaea;
			border-color: transparent;
			border: none;
		}

			.btn-rounded:hover {
				border-color: transparent;
				border: none;
			}

		.fixed-width-search-container {
			width: 250px; /* Set the fixed width you desire */
		}

		.small-badge {
			font-size: 0.65rem; /* smaller text */
			min-width: 18px; /* keeps it round */
			height: 18px;
			padding: 0; /* remove extra padding */
			display: flex;
			align-items: center;
			justify-content: center;
			border-radius: 50% !important; /* force perfect circle */
		}
		 
	</style>
</head>

<body>
	@if (!string.IsNullOrEmpty(ToastMessage))
	{
		<script>
			document.addEventListener("DOMContentLoaded", function () {
				showToast("@ToastMessage", "@ToastType");
			});
		</script>
	}

	<div class="wrapper">
		<!-- sidebar navigation component -->
		<!-- end of sidebar component -->
		<div id="body" class="active">
			<!-- navbar navigation component -->
			<!-- end of navbar navigation -->
			<div class="content">
				<div class="container">
					<div class="page-title">
						<h3 class="d-flex justify-content-between align-items-center">
							<span>Current Stock</span>

							<div class="position-relative d-inline-block">
								<a asp-action="LowStock" asp-controller="ControlPanel"
								   class="btn btn-sm btn-outline-danger position-relative">
									<i class="fas fa-exclamation-triangle"></i>
									<span> Low Stock</span>

									@if (ViewBag.LowStockCount > 0)
									{
										<span class="position-absolute top-0 start-100 translate-middle
	                                 bg-danger text-white rounded-circle small-badge">
											@ViewBag.LowStockCount
										</span>
									}
								</a>
							</div>
						</h3>
					</div>





					<div class="box box-primary">
						<div class="box-body">
							<!-- Add the search input box here with Bootstrap classes -->
							<div class="input-group mb-3 fixed-width-search-container">
								<input type="text" class="form-control" id="searchInput" placeholder="Search for Stock Name..." oninput="searchCategory()">
							</div>

							<!-- Add the scrollable table container -->
							<div class="table-container">
								<table class="table table-hover" id="dataTables-example">
									<thead>
										<tr>
											<th>No</th>
											<th>Item Name</th>
											<th>Purchased Qty</th>
											<th>Consumed Qty</th>
											<th>Remaining Qty</th>
										</tr>
									</thead>
									<tbody>
										@{
											int rowNumber = 1;
										}
										@foreach (var stock in Model)
										{
											var statusClass = stock.Remaining <= 5 ? "text-danger fw-bold" : "text-success fw-bold";
											<tr>
												<td>@rowNumber</td>
												<td>@stock.ItemName</td>
												<td>@stock.Purchased</td>
												<td>@stock.Sold</td>
												<td class="@statusClass">@stock.Remaining</td>
											</tr>
											rowNumber++;
										}
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- Delete Confirmation Modal -->
	<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmLabel" aria-hidden="true">
		<div class="modal-dialog" style="margin-top: 50px;">

			<div class="modal-content border-danger">
				<div class="modal-header bg-danger text-white">
					<h5 class="modal-title" id="deleteConfirmLabel"><i class="fas fa-exclamation-triangle"></i> Confirm Deletion</h5>
					<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>

				</div>
				<div class="modal-body text-center">
					Are you sure you want to delete this Method? This action cannot be undone.
				</div>
				<div class="modal-footer justify-content-center">
					<a id="confirmDeleteBtn" class="btn btn-danger">Yes, Delete</a>
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>


				</div>
			</div>
		</div>
	</div>
	<!-- Bootstrap scripts -->
	<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
	<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

	<!-- DataTables script for table functionality -->
	<script type="text/javascript" charset="utf8"
			src="https://cdn.datatables.net/1.11.7/js/jquery.dataTables.js"></script>
	<script>
		// Initialize DataTable
		$(document).ready(function () {
			$('#dataTables-example').DataTable();
		});

		function searchCategory() {
			// Get input value
			var input = $('#searchInput').val().toLowerCase();

			// Loop through each row in the table
			$('#dataTables-example tbody tr').each(function () {
				// Check if the input value is empty or matches any text in the first column (index 0)
				var rowData = $(this).find('td:eq(1)').text().toLowerCase();
				var isMatch = input === '' || rowData.indexOf(input) !== -1;

				// Show or hide the row based on the match condition
				$(this).toggle(isMatch);
			});
		}
		function confirmDelete(supplierId) {
			const deleteUrl = `/ControlPanel/DeleteMethod/${MethodId}`;
			$('#confirmDeleteBtn').attr('href', deleteUrl);
				$('#deleteConfirmModal').modal('show');
		}
	</script>
</body>
</html>
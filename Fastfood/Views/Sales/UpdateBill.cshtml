        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.min.js"></script>
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/popperjs/core@2.5.3/dist/umd/popper.min.js"></script>
        <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
        <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

        <script>
                        /* =======================
                           Toast Helper
                           ======================= */
                                        document.getElementById("customer-form").addEventListener("submit", function (e) {
                                // Check if cart table has rows inside tbody
                                const cartTable = document.querySelector("#Mycarttable tbody");
                                if (!cartTable || cartTable.rows.length === 0) {
                                    e.preventDefault(); // stop form submission
                                    showToast("Cart is empty. Please add items before saving.", "error");
                                    return false;
                                }
                            });
                                  function showToast(message, type) {
                                const bg = type === "error" ? "bg-danger" : "bg-success";
                                const toast = document.createElement("div");
                                toast.className = `toast align-items-center text-white ${bg} border-0 show position-fixed top-0 end-0 m-3`;
                                toast.role = "alert";
                                toast.innerHTML = `
                                    <div class="d-flex">
                                        <div class="toast-body">${message}</div>
                                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                                    </div>`;
                                document.body.appendChild(toast);

                                setTimeout(() => toast.remove(), 3000);
                            }

                        /* =======================
                           Global Stock Data
                           ======================= */
                        let stockRecords = [];
                                 function loadStockRecords() {
                            return $.get('/Sales/GetAvailableStockRecords')
                                .done(data => {
                                    stockRecords = data || [];
                                    console.log("✅ Fresh stock loaded:", stockRecords);

                                    // After loading fresh stock, check cart items
                                    refreshCartStock();   // <-- added here
                                })
                                .fail(() => showToast("Failed to load stock records.", "error"));
                        }


                      function fetchAvailableStock(itemId, itemType, itemName) {
                            if (itemType !== "Beverages") {
                                console.log("👉 Non-Beverage item clicked:", { itemId, itemName, itemType });
                                return $.Deferred().resolve(9999);
                            }

                            const normalizedName = (itemName || "").trim().toLowerCase();
                            console.log("🔍 Checking stock for clicked item:", { itemId, itemName: normalizedName });

                            let matchedRecord = null;

                            stockRecords.forEach(r => {
                              console.log("   📦 Backend record:", { ItemId: r.itemId, ItemName: r.itemName, availableQty: r.availableQty });

                                if (r.itemId == itemId) {
                                    console.log("   ✅ Matched by ItemId!", { itemId, backendId: r.itemId });
                                    matchedRecord = r;
                                } else if (r.itemName && r.itemName.trim().toLowerCase() === normalizedName) {
                                    console.log("   ✅ Matched by ItemName!", { clickedName: normalizedName, backendName: r.ItemName.trim().toLowerCase() });
                                    matchedRecord = r;
                                }
                            });

                                if (!matchedRecord) {
                                    console.warn("❌ No matching record found for:", { itemId, itemName: normalizedName });
                                } else {
                                    console.log("✔ Final matched record:", matchedRecord);
                                }

                return $.Deferred().resolve(matchedRecord ? matchedRecord.availableQty : 0).promise();
            }


                        /* =======================
                           Cart Calculations
                           ======================= */
                        function updateGrossTotal() {
                            let grossTotal = 0;
                            $('#Mycarttable tbody tr').each(function () {
                                grossTotal += parseFloat($(this).find('td:eq(4) input').val()) || 0;
                            });
                            $('#grosstotal').val(grossTotal.toFixed(2));
                            updateFinalTotal();
                            updatePayback();
                        }

                        function updateTotalPrice(row) {
                            const unitPrice = parseFloat(row.find('td:eq(1) input').val());
                            const quantity = parseInt(row.find('td:eq(2) input').val(), 10);
                            const discount = parseFloat(row.find('td:eq(3) input').val());
                            const netTotal = (unitPrice * quantity) - (discount * quantity);
                            row.find('td:eq(4) input').val(netTotal.toFixed(2));
                            updateGrossTotal();
                        }

                        function updateFinalTotal() {
                            const grosstotal = parseFloat($('#grosstotal').val()) || 0;
                            const billDiscountTotal = parseFloat($('#billDiscountTotal').val()) || 0;
                            $('#Finaltotal').val((grosstotal - billDiscountTotal).toFixed(2));
                        }

                        function updatePayback() {
                            const cashReceived = parseFloat($('#cashreceived').val()) || 0;
                            const finalTotal = parseFloat($('#Finaltotal').val()) || 0;
                            $('#payback').val((cashReceived - finalTotal).toFixed(2));
                        }

                        /* =======================
                           Table Cell Builders
                           ======================= */
                        function addCell(row, propertyName, type, index, defaultValue, cellClass) {
                            const input = $('<input>').attr({ type, name: `DynamicData[${index}].${propertyName}`, value: defaultValue }).prop('readonly', true);
                            row.append($('<td></td>').addClass(cellClass || '').append(input));
                        }

                        function addNetTotalCell(row, index, unitPrice, quantity, discount) {
                            const netTotal = (unitPrice * quantity) - discount;
                            const input = $('<input>').attr({ type: 'text', name: `DynamicData[${index}].NetTotal`, value: netTotal.toFixed(2) }).addClass('net-total').prop('readonly', true);
                            row.append($('<td></td>').append(input));
                        }

                        function addRemoveCell(row) {
                            const removeButton = $('<button type="button"></button>').addClass('btn btn-danger btn-sm').html('<i class="bi bi-trash"></i>').on('click', () => {
                                row.remove();
                                updateGrossTotal();
                            });
                            row.append($('<td></td>').append(removeButton));
                        }

                                    function addQuantityCell(row, propertyName, index, defaultValue, itemId, itemType, itemName) {
                                                const input = $('<input type="text">')
                                        .attr("name", `DynamicData[${index}].${propertyName}`) // ✅ FIX
                                        .addClass('normal-text quantity')
                                        .val(defaultValue || 1)
                                        .css({ 'font-size': '12px', 'margin': '0 2px' })
                                        .prop('readonly', true);
                                    const incrementButton = $('<button type="button">+</button>').addClass('quantity-button increment-button').css('font-size', '16px');
                                    const decrementButton = $('<button type="button">-</button>').addClass('quantity-button decrement-button').css('font-size', '16px');

                            incrementButton.on('click', () => {
                                const current = parseInt(input.val(), 10);
                                fetchAvailableStock(itemId, itemType, itemName).done(available => {
                                    let inCartQty = 0;
                                    $('#Mycarttable tbody tr').each(function () {
                                        if ($(this).data('item-id') == itemId) inCartQty += parseInt($(this).find('td:eq(2) input').val(), 10) || 0;
                                    });

                                    if (itemType === "Beverages" && inCartQty + 1 > available) {
                                        showToast(`Only ${available} in stock. You already have ${inCartQty} in cart.`, 'error');
                                        return;
                                    }

                                    input.val(current + 1);
                                    updateTotalPrice(row);
                                });
                            });

                            decrementButton.on('click', () => {
                                const current = parseInt(input.val(), 10);
                                if (current > 0) { input.val(current - 1); updateTotalPrice(row); }
                            });

                            row.append($('<td></td>').append($('<div></div>').addClass('quantity-buttons-container').append(decrementButton, input, incrementButton)));
                        }

                        /* =======================
                           Add Item to Cart
                           ======================= */
                                 function addItemToCart(item) {
                            const { itemId, itemName, recentUnitPrice: unitPrice, itemType = "Other" } = item;
                            const discount = 20;

                            // Always fetch fresh stock from server (no cache)
                            fetchAvailableStock(itemId, itemType, itemName).done(availableStock => {
                                if (itemType === "Beverages" && availableStock <= 0) {
                                    showToast("Item is out of stock.", "error");
                                    return;
                                }

                                const existingRow = $('#Mycarttable tbody tr').filter(function () {
                                    return $(this).find('input[name*=".ItemId"]').val() == itemId;
                                });

                                if (existingRow.length > 0) {
                                    const qtyInput = existingRow.find('td:eq(2) input');
                                    let currentQty = parseInt(qtyInput.val(), 10) || 0;

                                    // ✅ Recheck cart qty against *latest available stock*
                                    let inCartQty = 0;
                                    $('#Mycarttable tbody tr').each(function () {
                                        if ($(this).data('item-id') == itemId)
                                            inCartQty += parseInt($(this).find('td:eq(2) input').val(), 10) || 0;
                                    });

                                    if (itemType === "Beverages" && inCartQty + 1 > availableStock) {
                                        showToast(`Only ${availableStock} left in stock. You already have ${inCartQty} in cart.`, "error");
                                        return;
                                    }

                                    qtyInput.val(currentQty + 1);
                                    updateTotalPrice(existingRow);

                                    // highlight
                                    existingRow.css('background-color', '#d1ffd1');
                                    setTimeout(() => existingRow.css('background-color', ''), 200);
                                } else {
                                    // ✅ If stock is already 0, block adding
                                    if (itemType === "Beverages" && availableStock < 1) {
                                        showToast("This item just went out of stock.", "error");
                                        return;
                                    }

                                    const lastRow = $('#Mycarttable tbody tr:last');
                                    const index = lastRow.index() + 1;
                                    const newRow = $('<tr></tr>').attr({ 'data-item-id': itemId, 'data-item-type': itemType });

                                    addCell(newRow, "ItemName", "text", index, itemName, "item-name-cell");
                                    addCell(newRow, "Price", "text", index, unitPrice, "price-cell");
                                    addQuantityCell(newRow, "Quantity", index, 1, itemId, itemType, itemName);
                                    addCell(newRow, "Discount", "text", index, discount, "discount-cell");
                                    addNetTotalCell(newRow, index, unitPrice, 1, discount);
                                    addRemoveCell(newRow);
                                    addCell(newRow, "ItemId", "hidden", index, itemId);

                                    $('#Mycarttable tbody').append(newRow);
                                }

                                updateGrossTotal();
                                updatePayback();
                            }).fail(() => {
                                showToast("Failed to check stock. Please try again.", "error");
                            });
                        }

                        /* =======================
                           Populate Items Table
                           ======================= */
                        function populateFilteredTable(data) {
                            $('#filteredtable').empty();
                            let row = $('<tr>');
                            data.forEach((item, index) => {
                                const cell = `<td class="clickable-cell tablecell button-like align-items-center" data-item="${item.itemId}">${item.itemName}</td>`;
                                row.append(cell);
                                if ((index + 1) % 4 === 0) { $('#filteredtable').append(row); row = $('<tr>'); }
                            });
                            if (row.find('td').length > 0) $('#filteredtable').append(row);
                        }

                        /* =======================
                           Refresh Cart Stock
                           ======================= */
                        function refreshCartStock() {
                            $('#Mycarttable tbody tr').each(function () {
                                const row = $(this);
                                const itemId = row.data('item-id');
                                const itemType = row.data('item-type');
                                const itemName = row.find('td:eq(0) input').val();

                                fetchAvailableStock(itemId, itemType, itemName).done(stock => {
                                    const qtyInput = row.find('td:eq(2) input');
                                    const currentQty = parseInt(qtyInput.val(), 10);
                                    if (itemType === "Beverages" && currentQty > stock) {
                                        showToast(`Stock updated: Only ${stock} available for ${itemName}`, 'error');
                                        qtyInput.val(stock);
                                        updateTotalPrice(row);
                                    }
                                });
                            });
                        }

                        /* =======================
                           Document Ready
                           ======================= */
                        $(document).ready(function () {
                            $.ajaxSetup({ cache: false });
                            loadStockRecords();

                            let breadcrumbText = '';

                            // Category click
                            $(document).on('click', '.clickable-cell[data-category]', function () {
                                const categoryId = $(this).data('category'), categoryName = $(this).data('category-name');
                                $('#container1,#container2,#container3').hide();
                                breadcrumbText = `<a href="#" class="breadcrumb-link" data-category="Category">Category</a>  <span class="breadcrumb-text active-category">${categoryName}</span>  `;
                                $('#breadcrumb').html(breadcrumbText);
                                if (categoryId == 2) $('#container3').show();
                                else $.get('/Sales/FilterItems', { categoryId }, populateFilteredTable).done(() => $('#container2').show());
                            });

                            // Breadcrumb click
                            $('#breadcrumb').on('click', '.breadcrumb-link', function (e) {
                                e.preventDefault();
                                if ($(this).data('category') === 'Category') { $('#container1').show(); $('#container2,#container3').hide(); $('#breadcrumb').html('<a href="#" class="breadcrumb-link" data-category="Category">Category</a> '); }
                            });

                            // Remarks click
                            $(document).on('click', '.clickable-cell[data-remarks]', function () {
                                const remarks = $(this).data('remarks');
                                $.get('/Sales/FilterItemsByRemarks', { remarks }, populateFilteredTable).done(() => $('#container2').show());
                            });

                            // Item click
                            $(document).on('click', '.clickable-cell[data-item]', function () {
                                const itemId = $(this).data('item');
                                $.get('/Sales/FilterItemsByItemId', { itemId }).done(data => (data || []).forEach(addItemToCart));
                            });

                            // Cash & Bill Discount
                            $('#cashreceived').on('input', updatePayback);
                            $('#billDiscountTotal').on('input', updateFinalTotal);

                            // Auto-refresh cart stock
                            setInterval(() => {
                                loadStockRecords(); // reload latest stock from server
                                refreshCartStock();
                            }, 5000);
                                          var customerList = $('.customer-item');
                                        var resultContainer = $('#resultContainer');
                                        var dropdown = $('#customer-list');
                                        $(document).on('click', function (e) {
                                            if (!dropdown.is(e.target) && dropdown.has(e.target).length === 0) {
                                                customerList.hide();
                                                resultContainer.empty();
                                            }
                                        });
                                        $('#searchInput').on('input', function () {
                                            var searchTerm = $(this).val().toLowerCase();
                                            customerList.each(function () {
                                                var customerName = $(this).text().toLowerCase();
                                                if (customerName.includes(searchTerm)) {
                                                    $(this).show();
                                                } else {
                                                    $(this).hide();
                                                }
                                            });
                                            if ($('#customer-list .customer-item:visible').length === 0) {
                                                resultContainer.html('<p class="text-danger">No matching records found.</p>');
                                            } else {
                                                resultContainer.empty();
                                            }
                                        });
                                        $('#customer-list').on('click', '.customer-item', function () {
                                            var itemName = $(this).text().trim();
                                            $('#searchInput').val(itemName);
                                            customerList.hide();
                                            resultContainer.empty();
                                        });

                                                    loadStockRecords();

                            // 2. After stock is loaded, refresh the cart
                                       loadStockRecords();
                        });
                                     // === PAYMENT METHODS, CUSTOMER, MODALS (UNCHANGED) ===
                                    var creditCardRadio = document.getElementById('creditCardRadio');
                                    var authIdContainer = document.getElementById('authIdContainer');
                                    function handlePaymentMethodChange() {
                                        if (creditCardRadio.checked) {
                                            authIdContainer.style.display = 'table-cell';
                                        } else {
                                            authIdContainer.style.display = 'none';
                                        }
                                        openCreditCardModal();
                                    }
                                    function openCreditCardModal() {
                                        $('#creditCardModal').modal('show');
                                    }
                                    $('#closeModalButton, #closeModelButtonTop').click(function () {
                                        $('#creditCardModal').modal('hide');
                                    });
                                    function OpenCreateCustomerModal() {
                                        $('#CreateCustomerModel').modal('show');
                                    }
                                    $('#closeModelTopButton').click(function () {
                                        $('#CreateCustomerModel').modal('hide');
                                    });
                                    $('#closeModalButtonBottom').click(function () {
                                        $('#CreateCustomerModel').modal('hide');
                                    });

                                    $(document).on("click", "#CardDetailCheck", function () {
                                        var Bin = document.getElementById('CardBinNumber').value;
                                        console.log(Bin);
                                        $.ajax({
                                            url: '/Sales/BankDetail',
                                            method: 'GET',
                                            data: { Bin: Bin },
                                            success: function (data) {
                                                $('#BankName').val(data.bankName);
                                                $('#CardType').val(data.cardType);
                                                $('#CardCat').val(data.card_Cat);
                                                $('#Discount').val(data.discountPercent);
                                            },
                                            error: function (error) {
                                                console.error('Error:', error);
                                            }
                                        });
                                    });

                                    $(document).on("click", "#ApplyCardPayment", function () {
                                        var cardNumber = $('#cardNumber').val();
                                        var cardNumberError = $('#cardNumberError');
                                        if (!cardNumber) {
                                            cardNumberError.text("Card number is required.");
                                            return;
                                        }
                                        cardNumberError.text("");
                                        var finalTotal = parseFloat($('#Finaltotal').val()) || 0;
                                        var discountPercent = document.getElementById('Discount').value;
                                        var discountedTotal = finalTotal - (finalTotal * (discountPercent / 100));
                                        $('#Finaltotal').val(discountedTotal.toFixed(2));
                                        $('#creditCardModal').modal('hide');
                                    });
        </script>


    </body>
    </html>
}

